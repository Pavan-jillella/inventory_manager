rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Admin'; }
    match /products/{image} {
      allow read: if request.auth != null;
      allow create, update: if admin() && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
  }
}
