rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Front Desk']; }
    function admin() { return staff() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'; }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow write: if false; // Provision profiles through the Admin SDK, never the browser.
    }
    match /items/{id} { allow read: if staff(); allow create, delete: if admin(); allow update: if staff() && request.resource.data.stock is number && request.resource.data.stock >= 0 && (admin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])); }
    match /logs/{id} { allow read, create: if staff(); allow update, delete: if admin(); }
    match /settings/{id} { allow read: if staff(); allow write: if admin(); }
    match /ops_supplies/{id} {
      allow read: if staff();
      allow create, update: if staff() && request.resource.data.stock is number && request.resource.data.stock >= 0 && request.resource.data.minStock is number && request.resource.data.minStock >= 0 && request.resource.data.department in ['Breakfast', 'Housekeeping'];
      allow delete: if admin();
    }
    match /ops_days/{date} { allow read, create, update: if staff(); allow delete: if admin(); }
  }
}
